{
  "name": "last-job-novel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "preview": "vite preview",
    "deploy": "npm run check && npm run build:pages && gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
